{
    "name": "viewer-submissions-frontend",
    "version": "1.0.0",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "npm run typecheck && vite build",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:coverage": "vitest run --coverage",
        "typecheck": "tsc -b",
        "preview": "vite preview",
        "lint": "oxlint --max-warnings=0 --disable-nested-config .",
        "lint:fix": "oxlint --disable-nested-config . --fix",
        "format": "oxfmt --check ./src",
        "format:fix": "oxfmt ./src"
    },
    "dependencies": {
        "@fontsource/chakra-petch": "^5.3.0",
        "@fontsource/jersey-10": "^5.3.0",
        "@marsidev/react-turnstile": "^1.6.2",
        "@tanstack/react-query": "^5.104.3",
        "react": "^19.3.1",
        "react-dom": "^19.3.1",
        "react-is": "^19.3.1",
        "react-router": "^8.4.0",
        "recharts": "^3.10.1",
        "socket.io-client": "^4.8.4"
    },
    "devDependencies": {
        "@testing-library/dom": "^10.4.2",
        "@testing-library/jest-dom": "^7.0.1",
        "@testing-library/react": "^16.3.3",
        "@testing-library/user-event": "^14.6.8",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@vitejs/plugin-react": "^6.1.2",
        "@vitest/coverage-v8": "^5.0.5",
        "jsdom": "^30.1.3",
        "oxfmt": "^0.73.0",
        "oxlint": "^1.88.0",
        "typescript": "^7.0.2",
        "vite": "^8.3.4",
        "vitest": "^5.0.5"
    }
}
