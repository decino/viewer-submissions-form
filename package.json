{
    "name": "decinosubmissionbackend",
    "version": "1.0.0",
    "description": "Nerd",
    "type": "module",
    "scripts": {
        "lint": "eslint .",
        "lint:fix": "eslint --fix .",
        "tsc": "tsc --project tsconfig.json",
        "build": "npm run barrels && node ./buildScripts/cleanDist.mjs && swc src -d dist --config-file .swcrc --copy-files --strip-leading-paths",
        "barrels": "barrels",
        "start_js": "node dist/index.js",
        "start_js:ci": "node dist/index.js -ghAction",
        "start": "node --loader ts-node/esm src/index.ts",
        "start:prod": "cross-env NODE_ENV=production nodemon dist/index.js",
        "update_deps": "npx npm-check-updates",
        "typeorm": "typeorm-ts-node-esm",
        "blankmigration": "typeorm-ts-node-esm migration:create",
        "generatemigration": "typeorm-ts-node-esm migration:generate -d ./src/db/DataSource.ts",
        "runmigration": "typeorm-ts-node-esm migration:run -d ./src/db/DataSource.ts",
        "runmigration:ci": "node dist/db/runMigration.js -ghAction",
        "revertmigration": "typeorm-ts-node-esm migration:revert -d ./src/db/DataSource.ts",
        "prettier": "prettier ./src --check",
        "prettier:fix": "prettier ./src --write",
        "prepare": "husky"
    },
    "dependencies": {
        "@socket.io/redis-adapter": "^8.3.0",
        "@tsed/ajv": "^8.38.4",
        "@tsed/common": "^8.38.4",
        "@tsed/core": "^8.38.4",
        "@tsed/di": "^8.38.4",
        "@tsed/engines": "^8.38.4",
        "@tsed/exceptions": "^8.38.4",
        "@tsed/json-mapper": "^8.38.4",
        "@tsed/logger": "8.0.5",
        "@tsed/logger-file": "8.0.5",
        "@tsed/passport": "^8.38.4",
        "@tsed/platform-cache": "^8.38.4",
        "@tsed/platform-exceptions": "^8.38.4",
        "@tsed/platform-express": "^8.38.4",
        "@tsed/platform-log-middleware": "^8.38.4",
        "@tsed/platform-log-request": "^8.38.4",
        "@tsed/platform-middlewares": "^8.38.4",
        "@tsed/platform-multer": "^8.38.4",
        "@tsed/platform-params": "^8.38.4",
        "@tsed/platform-response-filter": "^8.38.4",
        "@tsed/platform-views": "^8.38.4",
        "@tsed/schema": "^8.38.4",
        "@tsed/socketio": "^8.38.4",
        "@tsed/swagger": "^8.38.4",
        "adm-zip": "^0.6.0",
        "ajv": "^8.20.0",
        "argon2": "^0.45.1",
        "better-sqlite3": "^12.11.1",
        "body-parser": "^2.3.0",
        "builder-pattern": "^2.2.0",
        "compression": "^1.8.1",
        "connect-typeorm": "^2.0.0",
        "cookie-parser": "^1.4.7",
        "cors": "^2.8.6",
        "cronstrue": "^3.24.0",
        "cross-env": "^10.1.0",
        "dotenv": "^17.4.2",
        "dotenv-expand": "^1000.0.0",
        "dotenv-flow": "^4.1.0",
        "ejs": "^6.0.1",
        "express": "^5.2.1",
        "express-rate-limit": "^8.0.1",
        "express-session": "^1.19.0",
        "file-type": "^22.0.2",
        "helmet": "^8.3.0",
        "http-status-codes": "^2.3.0",
        "is-localhost-ip": "^3.0.1",
        "jsdom": "^30.0.1",
        "lru-cache": "^11.5.2",
        "method-override": "^3.0.0",
        "mime": "^4.1.0",
        "node-schedule": "^2.1.1",
        "nodemailer": "^7.0.5",
        "passport": "^0.7.0",
        "passport-custom": "^1.2.1",
        "passport-http": "^0.3.0",
        "passport-local": "^1.0.0",
        "punycode": "^2.3.1",
        "redis": "^5.12.1",
        "socket.io": "^4.8.3",
        "toad-scheduler": "^4.1.0",
        "typeorm": "^0.3.25",
        "typeorm-rate-limit-store": "^1.1.1",
        "xss": "^1.0.15"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@swc/cli": "^0.8.1",
        "@swc/core": "^1.16.1",
        "@tsed/barrels": "7.6.2",
        "@tsed/cli-plugin-passport": "7.6.2",
        "@types/adm-zip": "^0.5.8",
        "@types/compression": "^1.8.1",
        "@types/cookie-parser": "^1.4.10",
        "@types/cors": "^2.8.19",
        "@types/express": "^5.0.6",
        "@types/express-session": "^1.19.0",
        "@types/jsdom": "^30.0.0",
        "@types/method-override": "^3.0.0",
        "@types/multer": "^2.2.0",
        "@types/node": "^24.1.0",
        "@types/node-schedule": "^2.1.8",
        "@types/nodemailer": "^8.0.1",
        "@types/passport": "^1.0.17",
        "@types/passport-http": "^0.3.11",
        "@types/passport-local": "^1.0.38",
        "@types/punycode": "^2.1.4",
        "eslint": "^10.9.1",
        "husky": "^9.1.7",
        "lint-staged": "^16.1.2",
        "nodemon": "^3.1.14",
        "prettier": "3.9.6",
        "ts-node": "^10.9.2",
        "ts-node-dev": "^2.0.0",
        "tsc-files": "^1.1.4",
        "tsconfig-paths": "^4.2.0",
        "tslib": "^2.8.1",
        "typescript": "npm:@typescript/typescript6@^6.0.2",
        "typescript-eslint": "^8.68.0",
        "@typescript/native": "npm:typescript@^7.0.2"
    },
    "main": "index.js",
    "keywords": [],
    "author": "Victoria",
    "license": "MIT",
    "tsed": {
        "packageManager": "npm",
        "convention": "default",
        "architecture": "default"
    },
    "lint-staged": {
        "src/**/*.ts": [
            "tsc-files --noEmit --pretty",
            "eslint --cache --fix",
            "prettier --write"
        ]
    }
}
