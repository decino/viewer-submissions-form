{
    "name": "decinosubmissionbackend",
    "version": "1.0.0",
    "description": "Nerd",
    "type": "module",
    "scripts": {
        "lint": "oxlint --max-warnings=0 --disable-nested-config .",
        "lint:fix": "oxlint --disable-nested-config --fix .",
        "tsc": "tsc --project tsconfig.json",
        "build": "npm run barrels && node ./buildScripts/cleanDist.mjs && tsc -p tsconfig.build.json",
        "barrels": "barrels",
        "start_js": "node dist/index.js",
        "start_js:ci": "node dist/index.js -ghAction",
        "start": "npm run build && npm run start_js",
        "start:dev": "npm run build && cross-env NODE_ENV=development node --enable-source-maps dist/index.js",
        "start:prod": "cross-env NODE_ENV=production node dist/index.js",
        "update_deps": "npx npm-check-updates",
        "typeorm": "typeorm",
        "blankmigration": "typeorm migration:create",
        "generatemigration": "npm run build && typeorm migration:generate -d ./dist/db/DataSource.js",
        "runmigration": "npm run build && node dist/db/runMigration.js",
        "runmigration:ci": "node dist/db/runMigration.js -ghAction",
        "revertmigration": "npm run build && typeorm migration:revert -d ./dist/db/DataSource.js",
        "format": "oxfmt --check ./src",
        "format:fix": "oxfmt ./src",
        "prepare": "husky"
    },
    "dependencies": {
        "@socket.io/redis-adapter": "^8.3.0",
        "@tsed/ajv": "^8.44.0",
        "@tsed/common": "^8.44.0",
        "@tsed/core": "^8.44.0",
        "@tsed/di": "^8.44.0",
        "@tsed/exceptions": "^8.44.0",
        "@tsed/json-mapper": "^8.44.0",
        "@tsed/logger": "8.0.7",
        "@tsed/logger-file": "8.0.7",
        "@tsed/passport": "^8.44.0",
        "@tsed/platform-cache": "^8.44.0",
        "@tsed/platform-exceptions": "^8.44.0",
        "@tsed/platform-express": "^8.44.0",
        "@tsed/platform-log-middleware": "^8.44.0",
        "@tsed/platform-log-request": "^8.44.0",
        "@tsed/platform-middlewares": "^8.44.0",
        "@tsed/platform-multer": "^8.44.0",
        "@tsed/platform-params": "^8.44.0",
        "@tsed/platform-response-filter": "^8.44.0",
        "@tsed/schema": "^8.44.0",
        "@tsed/socketio": "^8.44.0",
        "@tsed/swagger": "^8.44.0",
        "adm-zip": "^0.6.1",
        "ajv": "^8.20.0",
        "argon2": "^0.45.1",
        "better-sqlite3": "^12.11.1",
        "body-parser": "^2.3.0",
        "builder-pattern": "^2.2.0",
        "compression": "^1.8.2",
        "connect-typeorm": "^2.0.0",
        "cookie-parser": "^1.4.7",
        "cors": "^2.8.6",
        "cronstrue": "^3.32.0",
        "cross-env": "^10.1.0",
        "dotenv": "^18.0.8",
        "dotenv-expand": "^1000.0.0",
        "dotenv-flow": "^4.1.0",
        "express": "^5.3.0",
        "express-rate-limit": "^8.7.1",
        "express-session": "^1.19.0",
        "file-type": "^22.2.0",
        "helmet": "^8.3.0",
        "http-status-codes": "^2.3.0",
        "is-localhost-ip": "^3.0.1",
        "jsdom": "^30.1.3",
        "method-override": "^3.0.0",
        "mime": "^4.1.1",
        "node-schedule": "^2.1.1",
        "nodemailer": "^10.1.1",
        "passport": "^0.7.0",
        "passport-custom": "^1.2.1",
        "passport-http": "^0.3.0",
        "passport-local": "^1.0.0",
        "punycode": "^2.3.1",
        "redis": "^6.3.0",
        "socket.io": "^4.8.4",
        "toad-scheduler": "^4.2.0",
        "typeorm": "^1.1.2",
        "typeorm-rate-limit-store": "^1.1.1",
        "xss": "^1.0.15"
    },
    "devDependencies": {
        "@tsed/barrels": "7.8.1",
        "@tsed/cli-plugin-passport": "7.8.1",
        "@types/adm-zip": "^0.5.8",
        "@types/compression": "^1.8.1",
        "@types/cookie-parser": "^1.4.10",
        "@types/cors": "^2.8.19",
        "@types/express": "^5.0.6",
        "@types/express-session": "^1.19.0",
        "@types/jsdom": "^30.0.0",
        "@types/method-override": "^3.0.0",
        "@types/multer": "^2.3.0",
        "@types/node": "^26.6.5",
        "@types/node-schedule": "^2.1.8",
        "@types/passport": "^1.0.17",
        "@types/passport-http": "^0.3.11",
        "@types/passport-local": "^1.0.38",
        "@types/punycode": "^2.1.4",
        "concurrently": "^10.0.6",
        "husky": "^9.1.7",
        "lint-staged": "^17.6.0",
        "oxfmt": "^0.73.0",
        "oxlint": "^1.88.0",
        "tsc-files": "^1.1.4",
        "tslib": "^2.8.1",
        "typescript": "^7.0.2"
    },
    "main": "index.js",
    "keywords": [],
    "author": "Victoria",
    "license": "MIT",
    "tsed": {
        "packageManager": "npm",
        "convention": "default",
        "architecture": "default"
    },
    "lint-staged": {
        "src/**/*.ts": [
            "tsc-files --noEmit --pretty",
            "oxlint --max-warnings=0 --disable-nested-config --fix",
            "oxfmt"
        ]
    },
    "overrides": {
        "connect-typeorm": {
            "typeorm": "$typeorm"
        }
    },
    "allowScripts": {
        "@scarf/scarf@1.4.0": true,
        "argon2@0.45.1": true,
        "better-sqlite3@12.11.1": true,
        "@swc/core@1.16.1": true
    }
}
